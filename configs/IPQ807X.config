# ==========================================
# 核心系统与目标机型 (开启多设备模式骗过验证)
# ==========================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y

# ==========================================
# 唯一开启的目标机型 (扩容版 AX6)
# ==========================================
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_redmi_ax6=y

# ==========================================
# 暴力拉黑其他所有设备 (防止编译多余固件及设备漂移)
# ==========================================
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_aliyun_ap8220=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_arcadyan_aw1000=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_asus_rt-ax89x=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_buffalo_wxr-5950ax12=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_cmcc_rm2-6=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_compex_wpq873=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_dynalink_dl-wrx36=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_edgecore_eap102=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_edimax_cax1800=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_homewrk=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4200v1=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4200v2=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4300=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx5300=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx8500=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_netgear_rax120v2=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_netgear_sxr80=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_netgear_sxs80=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_netgear_wax218=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_netgear_wax620=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_netgear_wax630=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_prpl_haze=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_qnap_301w=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_redmi_ax6-stock=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_spectrum_sax1v1k=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_tplink_deco-x80-5g=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_tplink_eap620hd-v1=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_tplink_eap660hd-v1=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_verizon_cr1000a=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_xiaomi_ax3600-stock=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_xiaomi_ax3600=n
